{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:locale(de|en|tr)/projects/benlirad",
      "destination": "/:locale/projects",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/ratgeber/fallstudie-benlirad-lahr",
      "destination": "/:locale/ratgeber",
      "permanent": true
    },
    {
      "source": "/:locale(fr|ku)",
      "destination": "/de",
      "permanent": true
    },
    {
      "source": "/:locale(fr|ku)/:path*",
      "destination": "/de/:path*",
      "permanent": true
    },
    {
      "source": "/de/webdesign/freiburg",
      "destination": "/de",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/bewertungskarten/:path*",
      "destination": "/:locale/leistungen",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/bewertungskarten",
      "destination": "/:locale/leistungen",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/(digitale-visitenkarte|geschenkkarte)",
      "destination": "/:locale/leistungen",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/karte-gestalten/:path*",
      "destination": "/:locale/leistungen",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/bestellen/:path*",
      "destination": "/:locale/leistungen",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/bestellen",
      "destination": "/:locale/leistungen",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/abo",
      "destination": "/:locale/wartung",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.breisgau-digital.de"
        }
      ],
      "destination": "https://breisgau-digital.de/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?hamzaoeztuerk\\.de"
        }
      ],
      "destination": "https://breisgau-digital.de/:path*",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/experience",
      "destination": "/:locale/ueber-uns",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/lebenslauf",
      "destination": "/:locale/ueber-uns",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/projects/hochzeitseinladung",
      "destination": "/:locale/projects",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/projects/bewerbungs-manager",
      "destination": "/:locale/projects",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/projects/hotel-bergfrieden",
      "destination": "/:locale/projects",
      "permanent": true
    },
    {
      "source": "/:locale(de|en|tr)/smart-home",
      "destination": "/:locale/leistungen",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/einladung/:slug/planer",
      "destination": "/einladung/live/planer"
    },
    {
      "source": "/einladung/:slug",
      "destination": "/einladung/live"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/r/:slug",
      "destination": "/api"
    },
    {
      "source": "/m/:slug",
      "destination": "/api"
    },
    {
      "source": "/m/:slug/karte",
      "destination": "/api"
    },
    {
      "source": "/k/:slug",
      "destination": "/api"
    },
    {
      "source": "/k/:slug/kontakt.vcf",
      "destination": "/api"
    },
    {
      "source": "/k/:slug/kontakt",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "17 4 * * *"
    }
  ]
}
